# ─────────────────────────────────────────────────────────────
# HydroWild — Shopify Storefront API credentials
# ─────────────────────────────────────────────────────────────

# ── Server-side (Vercel → Project → Settings → Environment Variables) ──
# Powers real Cart API checkout via api/shopify.js. Never exposed to the
# browser — the client only ever talks to /api/shopify.

# Storefront API access token from:
#   Shopify Admin → Settings → Apps → Develop apps → [your app] → API credentials
# Requires scopes:
#   unauthenticated_read_product_listings
#   unauthenticated_read_product_inventory
#   unauthenticated_write_checkouts
SHOPIFY_STOREFRONT_TOKEN=your_storefront_api_token_here

# Optional — the store's .myshopify.com domain. Defaults to
# hydrowild.myshopify.com if unset.
SHOPIFY_STORE_DOMAIN=hydrowild.myshopify.com

# ── Client-side (Vite, copy to .env.local) ──
# Not a secret — only used to rewrite the returned checkoutUrl host and by
# the optional newsletter signup in src/js/main.js. Should match
# SHOPIFY_STORE_DOMAIN above.
VITE_SHOPIFY_DOMAIN=hydrowild.myshopify.com
